                { id: 30, nome: "Orecchiette alle cime di rapa", portata: "Primo Piatto", tags: ["Adatta a grandi quantità", "Estivo", "Pasta", "Veloce"], allergeni: ["Senza Lattosio", "Vegana"], ingredienti: [{nome: "Cime di rapa", qta: null, unita: ""}], porzioni: 4, preparazione: "", origine: "", immagine: "" }
