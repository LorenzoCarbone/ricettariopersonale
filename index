<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Il Mio Ricettario</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
        :root {
            --bg-body: #fdfaf6; --bg-card: #ffffff;
            --text-main: #2d3748; --text-light: #718096;
            --primary: #d97757; --primary-hover: #c06346;
            --border: #edf2f7;
            --tag-1: #e1f0e5; --text-tag-1: #2f855a;
            --tag-2: #feebc8; --text-tag-2: #c05621;
            --tag-3: #eebfbc; --text-tag-3: #9b2c2c;
            --tag-4: #e2e8f0; --text-tag-4: #2c5282;
            --tag-5: #e9d8fd; --text-tag-5: #553c9a;
            --radius: 12px;
            --shadow-sm: 0 4px 6px -1px rgba(0,0,0,0.05);
            --shadow-md: 0 10px 15px -3px rgba(0,0,0,0.08);
            --transition: all 0.2s ease;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Poppins', sans-serif; background-color: var(--bg-body);
            color: var(--text-main); line-height: 1.6; padding: 1.5rem;
            max-width: 1400px; margin: 0 auto; -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, .serif-font { font-family: 'Playfair Display', serif; }
        .hidden { display: none !important; }
        .view-section { animation: fadeIn 0.3s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* HEADER */
        header { text-align: center; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
        header h1 { font-size: 2.5rem; color: var(--primary); margin-bottom: 0.5rem; }
        header p { color: var(--text-light); font-size: 1rem; margin-bottom: 1.5rem; }
        
        .header-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-bottom: 10px; }
        .btn { display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 30px; font-weight: 500; font-size: 0.95rem; cursor: pointer; border: none; transition: var(--transition); font-family: inherit; }
        .btn-outline { background: transparent; border: 1px solid var(--primary); color: var(--primary); }
        .btn-outline:hover { background: rgba(217,119,87,0.1); }
        .btn-primary { background: var(--primary); color: white; }
        .btn-primary:hover { background: var(--primary-hover); transform: translateY(-2px); box-shadow: 0 4px 10px rgba(217,119,87,0.3); }

        /* VIEW CONTROLS */
        .view-controls-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 10px; }
        .view-toggle-group, .grouping-control { display: flex; align-items: center; gap: 8px; background: white; padding: 6px 12px; border-radius: 30px; border: 1px solid var(--border); font-size: 0.9rem; }
        .view-toggle-btn { background: none; border: none; color: var(--text-light); cursor: pointer; border-radius: 50%; padding: 4px; display: flex; align-items: center; justify-content: center; transition: var(--transition); }
        .view-toggle-btn.active { color: var(--primary); background: rgba(217,119,87,0.1); }
        .grouping-select { border: none; font-family: inherit; font-size: 0.9rem; color: var(--text-main); outline: none; cursor: pointer; background: transparent;}

        /* FILTERS */
        .controls { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 2rem; background: var(--bg-card); padding: 1rem; border-radius: var(--radius); box-shadow: var(--shadow-sm); align-items: center;}
        .search-wrapper { position: relative; flex: 1; min-width: 250px; }
        .search-wrapper i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-light); width: 18px;}
        .search-wrapper input { width: 100%; padding: 10px 15px 10px 40px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.95rem; background: #f8fafc; }
        .search-wrapper input:focus { outline: none; border-color: var(--primary); background: white; }
        
        .multi-select-container { position: relative; }
        .multi-select-button { padding: 10px 15px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.9rem; background: #f8fafc; color: var(--text-main); cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 10px; min-width: 160px; user-select: none;}
        .multi-select-button:hover { border-color: var(--primary); }
        .multi-select-badge { background: var(--primary); color: white; border-radius: 12px; padding: 2px 6px; font-size: 0.75rem; font-weight: 600;}
        .multi-select-dropdown { position: absolute; top: 110%; left: 0; background: white; border: 1px solid var(--border); border-radius: 8px; box-shadow: var(--shadow-md); z-index: 50; width: 220px; max-height: 250px; overflow-y: auto; display: none; flex-direction: column; padding: 8px; }
        .multi-select-dropdown.active { display: flex; }
        .multi-select-item { display: flex; align-items: center; gap: 8px; padding: 6px 8px; cursor: pointer; border-radius: 6px; font-size: 0.9rem;}
        .multi-select-item:hover { background: #f8fafc; }
        
        .active-filters-row { width: 100%; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 5px; align-items: center;}
        .active-filter-pill { display: inline-flex; align-items: center; gap: 4px; background: rgba(217,119,87,0.1); color: var(--primary); padding: 4px 10px; border-radius: 16px; font-size: 0.8rem; font-weight: 500;}
        .active-filter-pill i { cursor: pointer; width: 14px; }
        
        .filter-select { padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.9rem; background: #f8fafc; color: var(--text-main); outline: none; cursor: pointer; }

        /* GRID & COMPACT */
        .group-header-title { width: 100%; font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--text-main); border-bottom: 2px solid var(--border); padding-bottom: 8px; margin-top: 2rem; margin-bottom: 1.5rem; }
        .recipe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;}
        .recipe-card { background: var(--bg-card); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow-sm); cursor: pointer; transition: var(--transition); display: flex; flex-direction: column; position: relative; border: 1px solid transparent; overflow: hidden;}
        .recipe-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: rgba(217,119,87,0.3); }
        .recipe-card.has-image { background-size: cover; background-position: center; color: white; }
        .recipe-card.has-image::before { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 100%); z-index: 1; border-radius: inherit;}
        .recipe-card.has-image > * { position: relative; z-index: 2; }
        .recipe-card.has-image .recipe-title { color: white; }
        .recipe-card.has-image .ingredients-preview { color: #e2e8f0; border-top-color: rgba(255,255,255,0.2); }
        
        .card-actions-top { position: absolute; top: 12px; right: 12px; display: flex; gap: 6px; z-index: 10; }
        .icon-btn { background: white; border: 1px solid var(--border); border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-light); transition: var(--transition); }
        .icon-btn:hover { background: #f7fafc; color: var(--primary); border-color: var(--primary); }
        .icon-btn.danger:hover { color: #e53e3e; border-color: #e53e3e; }
        
        .portata-badge { display: inline-block; font-size: 0.7rem; text-transform: uppercase; font-weight: 600; color: var(--primary); margin-bottom: 0.3rem; }
        .recipe-title { font-size: 1.4rem; color: var(--text-main); margin-bottom: 0.8rem; line-height: 1.2; padding-right: 70px; }
        .tags-area { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 1rem; }
        .tag-pill { padding: 3px 8px; border-radius: 12px; font-size: 0.7rem; font-weight: 500; }
        .ingredients-preview { margin-top: auto; border-top: 1px solid var(--border); padding-top: 1rem; font-size: 0.85rem; color: var(--text-light); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

        .recipe-list-compact { display: flex; flex-direction: column; gap: 8px; margin-bottom: 2rem;}
        .compact-item { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 15px; padding: 12px 15px; background: var(--bg-card); border-radius: 8px; border: 1px solid var(--border); cursor: pointer; transition: var(--transition); }
        .compact-item:hover { box-shadow: var(--shadow-sm); border-color: var(--primary); background: #fdfaf6;}
        .compact-title { font-weight: 500; font-size: 1rem; color: var(--text-main); }
        .compact-tags { display: flex; gap: 5px; flex-wrap: wrap; }
        
        .no-results { grid-column: 1 / -1; text-align: center; padding: 3rem 1rem; color: var(--text-light); font-size: 1.1rem; background: var(--bg-card); border-radius: var(--radius); }

        /* DETAIL VIEW */
        .detail-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
        .back-btn { display: inline-flex; align-items: center; gap: 6px; color: var(--text-light); cursor: pointer; font-weight: 500; transition: var(--transition); border: none; background: none; font-size: 1rem; font-family: inherit;}
        .back-btn:hover { color: var(--primary); }
        .detail-title { font-size: 2.5rem; color: var(--primary); line-height: 1.1; margin-bottom: 0.5rem; margin-top: 1rem;}
        .detail-origin { color: var(--text-light); display: flex; align-items: center; gap: 5px; font-size: 0.95rem; }
        .portion-control { display: flex; align-items: center; gap: 10px; background: white; padding: 10px 15px; border-radius: 8px; border: 1px solid var(--border); display: inline-flex; margin-top: 1rem;}
        .portion-control input { width: 50px; text-align: center; border: 1px solid var(--border); border-radius: 4px; padding: 4px; font-family: inherit; font-size: 1rem;}
        .detail-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; }
        .ingredients-box { background: white; padding: 1.5rem; border-radius: var(--radius); border: 1px solid var(--border); align-self: start; }
        .ingredients-box h3 { font-size: 1.2rem; margin-bottom: 1rem; color: var(--text-main); }
        .ingredients-list-full { list-style: none; }
        .ingredients-list-full li { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed var(--border); font-size: 0.95rem; }
        .ingredients-list-full li:last-child { border-bottom: none; }
        .ing-qty { font-weight: 600; color: var(--primary); }
        .prep-box { font-size: 1.05rem; line-height: 1.8; color: var(--text-main); white-space: pre-wrap; }
        .prep-box h3 { font-size: 1.5rem; margin-bottom: 1rem; color: var(--text-main); }
        .detail-image { width: 100%; height: 300px; object-fit: cover; border-radius: var(--radius); margin-bottom: 1.5rem; border: 1px solid var(--border);}

        /* MODALS */
        .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(45, 55, 72, 0.6); backdrop-filter: blur(2px); display: none; justify-content: center; align-items: center; z-index: 1000; padding: 1rem; }
        .modal-overlay.active { display: flex; }
        .modal-content { background: var(--bg-card); width: 100%; max-width: 800px; max-height: 95vh; border-radius: var(--radius); display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); position: relative;}
        .modal-header { padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: #f8fafc;}
        .modal-header h2 { font-family: 'Playfair Display', serif; color: var(--primary); font-size: 1.5rem; }
        .close-modal { background: none; border: none; color: var(--text-light); cursor: pointer; }
        .modal-body { padding: 1.5rem; overflow-y: auto; }
        .form-group { margin-bottom: 1.2rem; }
        .form-group label { display: block; font-weight: 500; margin-bottom: 0.4rem; font-size: 0.9rem;}
        .form-control { width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.95rem; }
        textarea.form-control { min-height: 120px; resize: vertical; }
        
        .ing-editor-row { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 8px; margin-bottom: 8px; align-items: center;}
        .ing-list-manage { background: #f8fafc; border: 1px solid var(--border); border-radius: 8px; padding: 10px; min-height: 50px; margin-bottom: 10px;}
        .ing-list-item { display: flex; justify-content: space-between; align-items: center; background: white; padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; margin-bottom: 6px; font-size: 0.9rem;}
        .token-selector { border: 1px solid var(--border); border-radius: 8px; padding: 1rem; max-height: 150px; overflow-y: auto; display: flex; flex-wrap: wrap; gap: 6px; background: #f8fafc; }
        .token-checkbox { display: none; }
        .token-label { display: inline-block; padding: 4px 10px; background: white; border: 1px solid var(--border); border-radius: 16px; font-size: 0.8rem; cursor: pointer; user-select: none; transition: var(--transition);}
        .token-checkbox:checked + .token-label { background: var(--primary); color: white; border-color: var(--primary); }
        .modal-footer { padding: 1rem 1.5rem; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 10px; background: #f8fafc; }

        #toast-container { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; display: flex; flex-direction: column; gap: 10px; }
        .toast { background: var(--text-main); color: white; padding: 12px 24px; border-radius: 30px; font-size: 0.9rem; font-weight: 500; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); animation: slideUp 0.3s forwards; display: flex; align-items: center; gap: 8px; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        #pdf-export-container { display: none; width: 800px; padding: 40px; background: #fff; color: #333; }
        
        @media (max-width: 768px) {
            body { padding: 1rem; }
            header h1 { font-size: 2rem; }
            .view-controls-bar { flex-direction: column; align-items: flex-start; }
            .controls { flex-direction: column; align-items: stretch; }
            .search-wrapper, .multi-select-button { width: 100%; min-width: 100%; }
            .multi-select-dropdown { width: 100%; }
            .recipe-grid { grid-template-columns: 1fr; }
            .compact-item { grid-template-columns: 1fr auto; }
            .compact-tags, .compact-badge { display: none; } 
            .detail-layout { grid-template-columns: 1fr; gap: 1.5rem; }
            .detail-title { font-size: 2rem; }
            .modal-content { max-height: 100vh; height: 100vh; border-radius: 0; }
            .ing-editor-row { grid-template-columns: 1fr; gap: 5px; background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px solid var(--border);}
            .ing-mobile-group { display: flex; gap: 5px; }
            .ing-mobile-group input { flex: 1; }
            .modal-footer { position: sticky; bottom: 0; z-index: 10; box-shadow: 0 -4px 10px rgba(0,0,0,0.05); }
        }
    </style>
</head>
<body>
    <div id="main-view" class="view-section">
        <header>
            <h1>Ricettario</h1>
            <p>Archivio culinario personale e interattivo.</p>
            <div class="header-actions">
                <button class="btn btn-outline" onclick="openManagerModal()"><i data-lucide="settings-2"></i> Librerie</button>
                <button class="btn btn-outline" onclick="openImportModal()"><i data-lucide="code"></i> Importa Codice</button>
                <button class="btn btn-primary" onclick="openRecipeModal()"><i data-lucide="plus"></i> Nuova Ricetta</button>
            </div>
            <div class="header-actions" style="margin-top: 10px;">
                <button class="btn btn-outline" style="font-size: 0.85rem;" onclick="exportDatabase()"><i data-lucide="download-cloud"></i> Esporta Backup</button>
                <button class="btn btn-outline" style="font-size: 0.85rem;" onclick="document.getElementById('importBackupFile').click()"><i data-lucide="upload-cloud"></i> Importa Backup</button>
                <input type="file" id="importBackupFile" accept=".json" style="display:none" onchange="importDatabase(event)">
            </div>
        </header>

        <div class="view-controls-bar">
            <div class="grouping-control">
                <i data-lucide="layout-list" style="width:16px; color:var(--text-light)"></i> Raggruppa: 
                <select id="groupingSelect" class="grouping-select" onchange="renderRecipesUI()">
                    <option value="none">Nessuno</option>
                    <option value="portata">Per Portata</option>
                </select>
            </div>
            <div class="view-toggle-group">
                <button class="view-toggle-btn active" id="btnViewGrid" onclick="setViewMode('grid')"><i data-lucide="grid-3x3" style="width:18px;"></i></button>
                <button class="view-toggle-btn" id="btnViewCompact" onclick="setViewMode('compact')"><i data-lucide="list" style="width:18px;"></i></button>
            </div>
        </div>

        <div class="controls">
            <div class="search-wrapper">
                <i data-lucide="search"></i>
                <input type="text" id="searchInput" placeholder="Cerca nel ricettario..." oninput="applyFilters()">
            </div>
            
            <div class="multi-select-container">
                <div class="multi-select-button" onclick="toggleDropdown('dd-portata')">Portata <span class="multi-select-badge hidden" id="badge-portata">0</span> <i data-lucide="chevron-down" style="width:16px;"></i></div>
                <div class="multi-select-dropdown" id="dd-portata"></div>
            </div>

            <div class="multi-select-container">
                <div class="multi-select-button" onclick="toggleDropdown('dd-allergeni')">Allergeni <span class="multi-select-badge hidden" id="badge-allergeni">0</span> <i data-lucide="chevron-down" style="width:16px;"></i></div>
                <div class="multi-select-dropdown" id="dd-allergeni"></div>
            </div>

            <div class="multi-select-container">
                <div class="multi-select-button" onclick="toggleDropdown('dd-ingredienti')">Ingredienti <span class="multi-select-badge hidden" id="badge-ingredienti">0</span> <i data-lucide="chevron-down" style="width:16px;"></i></div>
                <div class="multi-select-dropdown" id="dd-ingredienti"></div>
            </div>

            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 0.85rem; color: var(--text-light); font-weight: 500;">Modo:</span>
                <select id="filterLogicToggle" class="filter-select" onchange="applyFilters()">
                    <option value="AND">E (Tutte le cond.)</option>
                    <option value="OR">O (Almeno una cond.)</option>
                </select>
            </div>

            <button class="btn btn-outline" style="border:none; padding:8px;" title="Pulisci Filtri" onclick="clearAllFilters()"><i data-lucide="filter-x"></i></button>
            <div class="active-filters-row" id="activeFiltersDisplay"></div>
        </div>

        <div id="recipeRenderContainer"></div>
    </div>

    <!-- VISTA DETTAGLIO RICETTA -->
    <div id="detail-view" class="view-section hidden">
        <div class="detail-header">
            <div>
                <button class="back-btn" onclick="showMainView()"><i data-lucide="arrow-left"></i> Torna al menu</button>
                <h1 class="detail-title" id="d-title">Nome Ricetta</h1>
                <div class="detail-origin" id="d-origin"></div>
                <div class="tags-area" id="d-tags" style="margin-top:10px;"></div>
                <div class="portion-control">
                    <i data-lucide="users"></i> Porzioni: 
                    <input type="number" id="portionInput" min="1" value="2" onchange="recalculatePortions()">
                </div>
            </div>
            <div style="display:flex; gap:10px;">
                <button class="icon-btn" onclick="editCurrentRecipe()" title="Modifica"><i data-lucide="pencil"></i></button>
                <button class="icon-btn" onclick="exportCurrentPDF()" title="Esporta PDF"><i data-lucide="file-down"></i></button>
            </div>
        </div>
        <img id="d-image" class="detail-image hidden" src="" alt="Immagine Ricetta">
        <div class="detail-layout">
            <div class="ingredients-box">
                <h3>Ingredienti</h3>
                <ul class="ingredients-list-full" id="d-ingredients"></ul>
            </div>
            <div class="prep-box">
                <h3>Preparazione</h3>
                <div id="d-prep"></div>
            </div>
        </div>
    </div>

    <!-- MODALE CREA/MODIFICA RICETTA -->
    <div class="modal-overlay" id="recipeModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalRecipeTitle">Nuova Ricetta</h2>
                <button class="close-modal" onclick="attemptCloseRecipeModal()"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="formRecipeId">
                <div class="form-group"><label>Nome Ricetta *</label><input type="text" id="formNome" class="form-control" placeholder="Es. Pappa al pomodoro"></div>
                <div class="form-group"><label>URL Immagine (opzionale)</label><input type="url" id="formImmagine" class="form-control" placeholder="Link immagine..."></div>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                    <div class="form-group"><label>Portata</label><select id="formPortata" class="form-control"></select></div>
                    <div class="form-group"><label>Porzioni Base</label><input type="number" id="formPorzioni" class="form-control" value="2" min="1"></div>
                </div>
                <div class="form-group">
                    <label>Ingredienti</label>
                    <div class="ing-editor-row">
                        <input type="text" id="formIngNome" class="form-control" list="ingDatalist" placeholder="Cerca/Scrivi..." oninput="autoFillUnit()">
                        <datalist id="ingDatalist"></datalist>
                        <div class="ing-mobile-group">
                            <input type="number" id="formIngQta" class="form-control" placeholder="Qta" step="0.1">
                            <input type="text" id="formIngUnit" class="form-control" placeholder="Unità">
                        </div>
                        <button class="btn btn-primary" style="padding:10px;justify-content:center;" onclick="addIngredientToForm()"><i data-lucide="plus"></i></button>
                    </div>
                    <div class="ing-list-manage" id="formAddedIngredients"></div>
                </div>
                <div class="form-group"><label>Preparazione</label><textarea id="formPrep" class="form-control" placeholder="Scrivi i passaggi..."></textarea></div>
                <div class="form-group"><label>Allergeni e Diete</label><div class="token-selector" id="formAllergeni"></div></div>
