        };

        let appData = JSON.parse(localStorage.getItem('ricettarioApp_v4'));
        if (!appData || appData.recipes.length < 30) { 
            appData = initialData; 
            saveData(); 
        }

        function saveData() { localStorage.setItem('ricettarioApp_v4', JSON.stringify(appData)); }

        // --- SISTEMA TOAST NOTIFICATION ---
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerHTML = `<i data-lucide="check-circle" style="color:#48bb78; width:18px;"></i> ${message}`;
            container.appendChild(toast);
            lucide.createIcons();
            setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3000);
        }

        // --- SISTEMA BACKUP ---
        function exportDatabase() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData));
            const node = document.createElement('a');
            node.setAttribute("href", dataStr);
            node.setAttribute("download", "ricettario_backup.json");
            document.body.appendChild(node);
            node.click();
            node.remove();
            showToast("Backup esportato.");
        }

        function importDatabase(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const importedData = JSON.parse(e.target.result);
                    if (importedData.recipes && importedData.portate) {
                        appData = importedData;
                        saveData();
                        initApp();
                        showToast("Backup importato con successo!");
                    } else { alert("File non valido."); }
                } catch (error) { alert("Errore di lettura."); }
            };
            reader.readAsText(file);
            event.target.value = ''; 
        }

        // --- STATO UI & FILTRI ---
        let viewMode = 'grid'; // grid | compact
        let groupBy = 'none'; // none | portata
        let currentRecipeId = null;
        let originalIngredients = []; 
        let basePortions = 2;
        let isFormDirty = false;

        let activeFilters = { portate: [], allergeni: [], ingredienti: [] };
        
        function setViewMode(mode) {
            viewMode = mode;
            document.getElementById('btnViewGrid').classList.toggle('active', mode === 'grid');
            document.getElementById('btnViewCompact').classList.toggle('active', mode === 'compact');
            renderRecipesUI();
        }

        // --- INIZIALIZZAZIONE ---
        function initApp() {
            lucide.createIcons();
            sortPortateArray(appData.portate);
            sortAlphabetical(appData.allergeni);
            sortAlphabetical(appData.tags);
            sortAlphabetical(appData.ingredienti);
            populateMultiSelects();
            renderRecipesUI();
        }
        
        window.onload = initApp;

        // --- MULTI-SELECT LOGIC ---
        function toggleDropdown(id) {
            const el = document.getElementById(id);
            const isAc = el.classList.contains('active');
            document.querySelectorAll('.multi-select-dropdown').forEach(d => d.classList.remove('active'));
            if(!isAc) el.classList.add('active');
        }
        
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.multi-select-container')) {
                document.querySelectorAll('.multi-select-dropdown').forEach(d => d.classList.remove('active'));
            }
        });

        function populateMultiSelects() {
            const buildList = (containerId, dataList, filterKey) => {
                const container = document.getElementById(containerId);
                container.innerHTML = dataList.map(item => `
                    <label class="multi-select-item">
                        <input type="checkbox" onchange="toggleFilter('${filterKey}', '${item.replace(/'/g, "\\'")}')" 
                        ${activeFilters[filterKey].includes(item) ? 'checked' : ''}> ${item}
                    </label>
                `).join('');
            };
            buildList('dd-portata', appData.portate, 'portate');
            buildList('dd-allergeni', appData.allergeni, 'allergeni');
            buildList('dd-ingredienti', appData.ingredienti, 'ingredienti');
            updateActiveFiltersDisplay();
        }

        function toggleFilter(filterKey, value) {
            const idx = activeFilters[filterKey].indexOf(value);
            if(idx > -1) activeFilters[filterKey].splice(idx, 1);
            else activeFilters[filterKey].push(value);
            populateMultiSelects(); 
            applyFilters();
        }

        function clearAllFilters() {
            activeFilters = { portate: [], allergeni: [], ingredienti: [] };
            document.getElementById('searchInput').value = '';
            populateMultiSelects();
            applyFilters();
        }

        function updateActiveFiltersDisplay() {
            document.getElementById('badge-portata').innerText = activeFilters.portate.length;
            document.getElementById('badge-portata').classList.toggle('hidden', activeFilters.portate.length === 0);
            document.getElementById('badge-allergeni').innerText = activeFilters.allergeni.length;
            document.getElementById('badge-allergeni').classList.toggle('hidden', activeFilters.allergeni.length === 0);
            document.getElementById('badge-ingredienti').innerText = activeFilters.ingredienti.length;
            document.getElementById('badge-ingredienti').classList.toggle('hidden', activeFilters.ingredienti.length === 0);

            let allActive = [];
            for (let k in activeFilters) {
                activeFilters[k].forEach(val => allActive.push({key: k, val}));
            }
            const row = document.getElementById('activeFiltersDisplay');
            row.innerHTML = allActive.map(f => `
                <span class="active-filter-pill">${f.val} <i data-lucide="x" onclick="toggleFilter('${f.key}', '${f.val.replace(/'/g, "\\'")}')"></i></span>
            `).join('');
            lucide.createIcons();
        }

        function applyFilters() {
            updateActiveFiltersDisplay();
            renderRecipesUI();
        }

        function getFilteredRecipes() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            return appData.recipes.filter(r => {
                const txt = r.nome.toLowerCase().includes(search) || (r.preparazione && r.preparazione.toLowerCase().includes(search));
                const p = activeFilters.portate.length === 0 || activeFilters.portate.includes(r.portata);
                // Tutti gli allergeni selezionati devono essere presenti
                const a = activeFilters.allergeni.length === 0 || activeFilters.allergeni.every(x => (r.allergeni||[]).includes(x));
                // Tutti gli ingredienti selezionati devono essere presenti
                const i = activeFilters.ingredienti.length === 0 || activeFilters.ingredienti.every(x => (r.ingredienti||[]).some(ri => ri.nome === x));
                return txt && p && a && i;
            });
        }

        function renderRecipesUI() {
            groupBy = document.getElementById('groupingSelect').value;
            let list = getFilteredRecipes();
            const container = document.getElementById('recipeRenderContainer');
            container.innerHTML = '';

            if (list.length === 0) {
                container.innerHTML = '<div class="no-results">Nessuna ricetta trovata con i filtri attuali.</div>';
                return;
            }

            if (groupBy === 'portata') {
                // Raggruppamento
                sortPortateArray(appData.portate).forEach(port => {
                    const groupItems = list.filter(r => r.portata === port);
                    if (groupItems.length > 0) {
                        container.innerHTML += `<div class="group-header-title">${port}</div>`;
                        container.innerHTML += generateHTMLForList(groupItems);
                    }
                });
                const noPortata = list.filter(r => !r.portata);
                if (noPortata.length > 0) {
                    container.innerHTML += `<div class="group-header-title">Senza Portata</div>`;
                    container.innerHTML += generateHTMLForList(noPortata);
                }
            } else {
                // Nessun raggruppamento
                container.innerHTML = generateHTMLForList(list);
            }
            lucide.createIcons();
        }

        function generateHTMLForList(recipes) {
            if (viewMode === 'compact') {
                return `<div class="recipe-list-compact">` + recipes.map(r => {
                    const tagsHtml = [...(r.allergeni||[]), ...(r.tags||[])].slice(0,3).map(t => `<span class="tag-pill" style="${getTagStyle(t)}">${t}</span>`).join('');
                    return `
                    <div class="compact-item" onclick="showDetailView(${r.id})">
                        <span class="portata-badge compact-badge" style="margin:0;">${r.portata || '-'}</span>
                        <div class="compact-title">${r.nome}</div>
                        <div class="compact-tags">${tagsHtml}</div>
                        <div class="compact-actions">
                            <button class="icon-btn danger" onclick="event.stopPropagation(); deleteRecipe(${r.id})"><i data-lucide="trash-2"></i></button>
                        </div>
                    </div>`;
                }).join('') + `</div>`;
            } else {
                // Griglia Cards
                return `<div class="recipe-grid">` + recipes.map(r => {
                    const allTags = [...(r.allergeni||[]), ...(r.tags||[])].slice(0, 3);
                    const tagsHtml = allTags.map(t => `<span class="tag-pill" style="${getTagStyle(t)}">${t}</span>`).join('') + (r.tags.length > 3 ? '<span class="tag-pill" style="background:#eee;color:#666;">+</span>' : '');
                    const ingPreview = r.ingredienti && r.ingredienti.length > 0 ? r.ingredienti.map(i => i.nome).join(', ') : 'Da inserire...';
                    const hasImg = r.immagine && r.immagine.trim() !== "";
                    const bgStyle = hasImg ? `style="background-image: url('${r.immagine}');"` : "";

                    return `
                    <div class="recipe-card ${hasImg ? 'has-image' : ''}" ${bgStyle} onclick="showDetailView(${r.id})">
                        <div class="card-actions-top">
                            <button class="icon-btn danger" onclick="event.stopPropagation(); deleteRecipe(${r.id})" title="Elimina"><i data-lucide="trash-2" style="width:14px;"></i></button>
                        </div>
                        <span class="portata-badge">${r.portata || ''}</span>
                        <h3 class="recipe-title serif-font">${r.nome}</h3>
                        <div class="tags-area">${tagsHtml}</div>
                        <div class="ingredients-preview"><strong>Ingredienti:</strong> ${ingPreview}</div>
                    </div>`;
                }).join('') + `</div>`;
            }
        }

        // --- NAVIGAZIONE VISTE ---
        function showDetailView(id) {
            currentRecipeId = id;
            document.getElementById('main-view').classList.add('hidden');
            document.getElementById('detail-view').classList.remove('hidden');
            
            const recipe = appData.recipes.find(r => r.id === id);
            
            document.getElementById('d-title').innerText = recipe.nome;
            document.getElementById('d-origin').innerHTML = recipe.origine ? `<i data-lucide="map-pin" style="width:14px;"></i> ${recipe.origine}` : '';
            
            const imgEl = document.getElementById('d-image');
            if(recipe.immagine) { imgEl.src = recipe.immagine; imgEl.classList.remove('hidden'); } 
            else { imgEl.classList.add('hidden'); }
            
            const allTags = [...(recipe.allergeni||[]), ...(recipe.tags||[])];
            document.getElementById('d-tags').innerHTML = allTags.map(t => `<span class="tag-pill" style="${getTagStyle(t)}">${t}</span>`).join('');
            
            basePortions = recipe.porzioni || 2;
            document.getElementById('portionInput').value = basePortions;
            originalIngredients = JSON.parse(JSON.stringify(recipe.ingredienti || []));
            document.getElementById('d-prep').innerText = recipe.preparazione || "Procedimento non specificato. Premi la matita per aggiungerlo!";
            
            recalculatePortions(); 
            lucide.createIcons();
            window.scrollTo(0,0);
        }

        function showMainView() {
            document.getElementById('detail-view').classList.add('hidden');
            document.getElementById('main-view').classList.remove('hidden');
            currentRecipeId = null;
            renderRecipesUI();
        }

        function recalculatePortions() {
            const currentPortions = parseFloat(document.getElementById('portionInput').value) || basePortions;
            const ratio = currentPortions / basePortions;
            const ul = document.getElementById('d-ingredients');
            ul.innerHTML = '';
            
            if(originalIngredients.length === 0) {
                ul.innerHTML = '<li><span style="color:#999;">Nessun ingrediente inserito.</span></li>'; return;
            }
            originalIngredients.forEach(ing => {
                let displayQty = "";
                if(ing.qta) {
                    let newQta = ing.qta * ratio;
                    displayQty = Number.isInteger(newQta) ? newQta : newQta.toFixed(1);
                }
                ul.innerHTML += `<li><span>${ing.nome}</span> <span class="ing-qty">${displayQty} ${ing.unita || ''}</span></li>`;
            });
        }

        // --- GESTIONE FORM RICETTA ---
        let tempIngredients = [];

        function markDirty() { isFormDirty = true; }

        function editCurrentRecipe() { if(currentRecipeId) openRecipeModal(currentRecipeId); }

        function openRecipeModal(id = null) {
            isFormDirty = false;
            document.getElementById('recipeModal').classList.add('active');
            document.getElementById('modalRecipeTitle').innerText = id ? 'Modifica Ricetta' : 'Nuova Ricetta';
            
            // Listeners per sporcare il form
            document.querySelectorAll('#recipeModal input, #recipeModal textarea, #recipeModal select').forEach(el => {
                el.addEventListener('input', markDirty, {once:true});
            });
            
            document.getElementById('formPortata').innerHTML = '<option value="">-- Nessuna --</option>' + sortPortateArray(appData.portate).map(p => `<option value="${p}">${p}</option>`).join('');
            
            // Popola Datalist
            document.getElementById('ingDatalist').innerHTML = sortAlphabetical(appData.ingredienti).map(i => `<option value="${i}">`).join('');
            
            const buildTokens = (cId, list, gName) => {
                document.getElementById(cId).innerHTML = sortAlphabetical(list).map((item, i) => `
                    <div><input type="checkbox" id="${gName}_${i}" value="${item}" class="token-checkbox" name="${gName}" onchange="markDirty()">
                    <label for="${gName}_${i}" class="token-label">${item}</label></div>
                `).join('');
            };
            buildTokens('formAllergeni', appData.allergeni, 'chk_all');
            buildTokens('formTags', appData.tags, 'chk_tag');

            tempIngredients = [];

            if (id) {
                const r = appData.recipes.find(x => x.id === id);
                document.getElementById('formRecipeId').value = r.id;
                document.getElementById('formNome').value = r.nome;
                document.getElementById('formImmagine').value = r.immagine || '';
                document.getElementById('formPortata').value = r.portata || '';
                document.getElementById('formPorzioni').value = r.porzioni || 2;
                document.getElementById('formPrep').value = r.preparazione || '';
                document.getElementById('formOrigine').value = r.origine || '';
                tempIngredients = JSON.parse(JSON.stringify(r.ingredienti || []));
                
                document.getElementsByName('chk_all').forEach(cb => { if((r.allergeni||[]).includes(cb.value)) cb.checked = true; });
                document.getElementsByName('chk_tag').forEach(cb => { if((r.tags||[]).includes(cb.value)) cb.checked = true; });
            } else {
                document.getElementById('formRecipeId').value = '';
                document.getElementById('formNome').value = '';
                document.getElementById('formImmagine').value = '';
                document.getElementById('formPortata').value = '';
                document.getElementById('formPorzioni').value = 2;
                document.getElementById('formPrep').value = '';
                document.getElementById('formOrigine').value = '';
            }
            renderFormIngredients();
        }

        function attemptCloseRecipeModal() {
            if(isFormDirty) {
                if(confirm("Hai modifiche non salvate. Vuoi chiudere lo stesso e perderle?")) { closeModal('recipeModal'); }
            } else { closeModal('recipeModal'); }
        }

        function addIngredientToForm() {
            const nomeInput = document.getElementById('formIngNome');
            let nome = nomeInput.value.trim();
            nome = nome.charAt(0).toUpperCase() + nome.slice(1).toLowerCase(); // Capitalize

            const qta = parseFloat(document.getElementById('formIngQta').value) || null;
            const unita = document.getElementById('formIngUnit').value.trim();
            
            if(!nome) return alert("Inserisci il nome dell'ingrediente.");
            
            // Auto add new ingredient to DB
            if(!appData.ingredienti.some(i => i.toLowerCase() === nome.toLowerCase())) {
                appData.ingredienti.push(nome);
                sortAlphabetical(appData.ingredienti);
                saveData();
                populateMultiSelects(); // update background filters
                document.getElementById('ingDatalist').innerHTML = appData.ingredienti.map(i => `<option value="${i}">`).join('');
                showToast(`Nuovo ingrediente "${nome}" aggiunto al database!`);
            }
            
            tempIngredients.push({ nome, qta, unita });
            nomeInput.value = '';
            document.getElementById('formIngQta').value = '';
            document.getElementById('formIngUnit').value = '';
            markDirty();
            renderFormIngredients();
            nomeInput.focus(); // keep focus for fast typing
        }

        function removeIngredientFromForm(idx) {
            tempIngredients.splice(idx, 1);
            markDirty();
            renderFormIngredients();
        }

        function renderFormIngredients() {
            const container = document.getElementById('formAddedIngredients');
            if(tempIngredients.length === 0) {
                container.innerHTML = '<span style="color:#999;font-size:0.9rem;">Nessun ingrediente inserito.</span>'; return;
            }
            container.innerHTML = tempIngredients.map((ing, i) => `
                <div class="ing-list-item">
                    <span><strong>${ing.nome}</strong> ${ing.qta ? ': ' + ing.qta : ''} ${ing.unita || ''}</span>
                    <button class="icon-btn danger" style="width:24px;height:24px;" onclick="removeIngredientFromForm(${i})"><i data-lucide="x" style="width:14px;"></i></button>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function saveRecipe() {
            const id = document.getElementById('formRecipeId').value;
            const nome = document.getElementById('formNome').value.trim();
            if (!nome) return alert("Il nome della ricetta è obbligatorio.");

            const rData = {
                id: id ? parseInt(id) : (appData.recipes.length > 0 ? Math.max(...appData.recipes.map(x=>x.id))+1 : 1),
                nome: nome,
                immagine: document.getElementById('formImmagine').value.trim(),
                portata: document.getElementById('formPortata').value,
                porzioni: parseInt(document.getElementById('formPorzioni').value) || 2,
                ingredienti: tempIngredients,
                preparazione: document.getElementById('formPrep').value,
                allergeni: Array.from(document.querySelectorAll(`input[name="chk_all"]:checked`)).map(cb => cb.value),
                tags: Array.from(document.querySelectorAll(`input[name="chk_tag"]:checked`)).map(cb => cb.value),
                origine: document.getElementById('formOrigine').value
            };

            if (id) {
                const idx = appData.recipes.findIndex(x => x.id == id);
                appData.recipes[idx] = rData;
                if(currentRecipeId == id) showDetailView(id); 
            } else {
                appData.recipes.unshift(rData);
            }

            saveData();
            isFormDirty = false;
            closeModal('recipeModal');
            showToast("Ricetta salvata con successo!");
            if(!currentRecipeId) renderRecipesUI();
        }

        // --- SISTEMA IMPORTAZIONE CODICE ---
        function openImportModal() {
            document.getElementById('importCodeInput').value = '';
            document.getElementById('importModal').classList.add('active');
        }

        function importRecipeCode() {
            try {
                const codeString = document.getElementById('importCodeInput').value;
                if (!codeString.trim()) throw new Error("Il campo è vuoto.");
                
                const newRecipe = JSON.parse(codeString);
                if (!newRecipe.nome) throw new Error("Manca il 'nome' della ricetta.");

                newRecipe.id = appData.recipes.length > 0 ? Math.max(...appData.recipes.map(x=>x.id))+1 : 1;

                const addIfMissing = (arr, val) => { if (val && !arr.includes(val)) arr.push(val); };
                
                addIfMissing(appData.portate, newRecipe.portata);
                (newRecipe.tags || []).forEach(t => addIfMissing(appData.tags, t));
                (newRecipe.allergeni || []).forEach(a => addIfMissing(appData.allergeni, a));
                (newRecipe.ingredienti || []).forEach(ing => {
                    if (ing.nome) {
                        const n = ing.nome.charAt(0).toUpperCase() + ing.nome.slice(1).toLowerCase();
                        ing.nome = n; // normalizza
                        if(!appData.ingredienti.some(i => i.toLowerCase() === n.toLowerCase())) appData.ingredienti.push(n);
                    }
                });

                appData.recipes.unshift(newRecipe);
                saveData();
                closeModal('importModal');
                initApp(); // Riordina, ripopola filtri e renderizza
                showToast("Ricetta importata e librerie aggiornate!");
            } catch (e) {
                alert("Errore nell'importazione. Assicurati che il codice JSON sia corretto.\n\nDettaglio: " + e.message);
            }
        }

        function deleteRecipe(id) {
            if (confirm("Sei sicuro di voler eliminare questa ricetta?")) {
                appData.recipes = appData.recipes.filter(r => r.id !== id);
                saveData();
                renderRecipesUI();
                showToast("Ricetta eliminata.");
            }
        }

        // --- GESTORE LIBRERIE GLOBALI ---
        function openManagerModal() { document.getElementById('managerModal').classList.add('active'); renderManagerList(); }
        
        function renderManagerList() {
            const type = document.getElementById('managerType').value;
            let list = appData[type];
            if(type === 'portate') list = sortPortateArray([...list]);
            else list = sortAlphabetical([...list]);

            document.getElementById('metaItemsContainer').innerHTML = list.map((item) => {
                const realIdx = appData[type].indexOf(item);
                return `
                <div style="display:flex; justify-content:space-between; padding:8px; border-bottom:1px solid #eee;">
                    <span>${item}</span>
                    <button class="icon-btn danger" style="width:24px;height:24px;border:none;" onclick="deleteMetaItem('${type}', ${realIdx})"><i data-lucide="trash-2" style="width:14px;"></i></button>
                </div>`;
            }).join('');
            lucide.createIcons();
        }

        function addMetaItem() {
            const type = document.getElementById('managerType').value;
            let val = document.getElementById('newMetaInput').value.trim();
            if(type !== 'portate') val = val.charAt(0).toUpperCase() + val.slice(1).toLowerCase();

            if(val && !appData[type].some(i=>i.toLowerCase()===val.toLowerCase())) {
                appData[type].push(val); saveData(); document.getElementById('newMetaInput').value = ''; renderManagerList();
                showToast("Elemento aggiunto.");
            }
        }
        function deleteMetaItem(type, idx) { appData[type].splice(idx, 1); saveData(); renderManagerList(); }
        function closeManagerAndRefresh() { closeModal('managerModal'); initApp(); }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }

        // --- PDF EXPORT ---
        function exportCurrentPDF() {
            if(!currentRecipeId) return;
            const recipe = appData.recipes.find(r => r.id === currentRecipeId);
            const container = document.getElementById('pdf-export-container');
            const p = parseFloat(document.getElementById('portionInput').value) || recipe.porzioni;
            const ings = Array.from(document.getElementById('d-ingredients').children).map(li => li.innerText).map(t => `<li>${t}</li>`).join('');

            container.innerHTML = `
                <div style="text-align:center; border-bottom: 2px solid #d97757; padding-bottom:20px; margin-bottom:30px;">
                    <div style="color:#718096; font-size:14px; text-transform:uppercase;">${recipe.portata || ''}</div>
                    <h1 style="font-family:'Playfair Display', serif; font-size:36px; color:#2d3748; margin:10px 0;">${recipe.nome}</h1>
                    ${recipe.origine ? `<div style="font-size:14px; color:#718096;">${recipe.origine}</div>` : ''}
                </div>
                <div style="display:flex; gap:30px;">
                    <div style="flex:1;">
                        <h3 style="color:#d97757; border-bottom:1px solid #eee; margin-bottom:15px; padding-bottom:5px;">Ingredienti (per ${p} porzioni)</h3>
                        <ul style="list-style:none; padding:0; line-height:2;">${ings || 'Nessun ingrediente.'}</ul>
                        <h3 style="color:#d97757; border-bottom:1px solid #eee; margin-top:30px; margin-bottom:15px; padding-bottom:5px;">Info</h3>
                        <p style="font-size:12px; color:#555;"><strong>Allergeni:</strong> ${(recipe.allergeni||[]).join(', ')}</p>
                        <p style="font-size:12px; color:#555;"><strong>Tag:</strong> ${(recipe.tags||[]).join(', ')}</p>
                    </div>
                    <div style="flex:2;">
                        <h3 style="color:#d97757; border-bottom:1px solid #eee; margin-bottom:15px; padding-bottom:5px;">Preparazione</h3>
                        <div style="line-height:1.8; white-space:pre-wrap; color:#333;">${recipe.preparazione || ''}</div>
                    </div>
                </div>
            `;
            container.style.display = 'block';
            html2pdf().set({
                margin: 15, filename: `Ricetta_${recipe.nome.replace(/\s+/g, '_')}.pdf`,
                image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            }).from(container).save().then(() => container.style.display = 'none');
        }
    </script>
</body>
</html>
