        function sortPortateArray(arr) {
            return arr.sort((a, b) => {
                let idxA = PORTATE_ORDER.indexOf(a);
                let idxB = PORTATE_ORDER.indexOf(b);
                if (idxA === -1) idxA = 999;
                if (idxB === -1) idxB = 999;
                if (idxA === idxB) return a.localeCompare(b);
                return idxA - idxB;
            });
        }
        
        function sortAlphabetical(arr) {
            return arr.sort((a,b) => a.localeCompare(b, 'it', {sensitivity: 'base'}));
