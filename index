    <div id="toast-container"></div>
    <div id="pdf-export-container"></div>

    <script>
        // --- INIZIALIZZAZIONE SICURA JAVASCRIPT ---
        
        const initialData = {
            portate: ["Antipasto", "Primo Piatto", "Secondo Piatto", "Contorno", "Piatto Unico", "Dessert", "Panino"],
            allergeni: ["Senza Lattosio", "Vegana", "Senza glutine", "Contiene piccante", "Vegetariana"],
            tags: ["Adatta a grandi quantità", "Casereccia", "Invernale", "Zuppa", "Campeggio", "Cucina indiana", "Tradizionale", "Al sacco", "Estivo", "Veloce", "Speciale", "Divertente", "Cottura lenta", "Ragu", "Sperimentale", "Pasta", "Risotto", "Forno", "Fresco", "Torta salata", "Lunga preparazione", "Fritto", "Salsa", "Ricetta personale"],
            ingredienti: ["Aglio", "Broccoli", "Burro", "Carote", "Cavolfiore", "Cime di rapa", "Cipolla", "Curry", "Fagioli", "Formaggio", "Funghi", "Gorgonzola", "Legumi", "Lenticchie", "Melanzane", "Mozzarella", "Nocciole", "Noci", "Olio EVO", "Pane", "Patate", "Pecorino", "Pepe", "Peperoni", "Pesto", "Piselli", "Polenta", "Pomodori secchi", "Pomodoro", "Porri", "Radicchio", "Ricotta", "Ricotta salata", "Riso", "Sale", "Salvia", "Scarola", "Uova", "Zucca", "Zucchine", "Acqua"],
            unita_misura: {},
            recipes: [
                { id: 1, nome: "Pappa al pomodoro", portata: "Piatto Unico", tags: ["Adatta a grandi quantità", "Casereccia", "Invernale", "Zuppa"], allergeni: ["Senza Lattosio", "Vegana"], ingredienti: [{nome: "Pomodoro"}], porzioni: 4, origine: "Italiana, Toscana" },
                { id: 2, nome: "Jamaican lentil stew", portata: "Piatto Unico", tags: ["Adatta a grandi quantità", "Campeggio", "Casereccia", "Cucina indiana", "Invernale", "Tradizionale", "Zuppa"], allergeni: ["Contiene piccante", "Senza Lattosio", "Senza glutine", "Vegana"], ingredienti: [{nome: "Carote"}, {nome: "Curry"}, {nome: "Legumi"}, {nome: "Lenticchie"}, {nome: "Peperoni"}], porzioni: 4 }
            ]
        };

        // 2. Variabili Globali
        let appData = null;
        let viewMode = 'grid'; 
        let groupBy = 'none'; 
        let currentRecipeId = null;
        let originalIngredients = []; 
        let basePortions = 2;
        let isFormDirty = false;
        let activeFilters = { portate: [], allergeni: [], ingredienti: [] };
        let tempIngredients = [];
        
        // FIX PRINCIPALE: Rinominato da supabase a supabaseClient per evitare la collisione fatale
        let supabaseClient = null;

        // 3. TENTATIVO CONNESSIONE SUPABASE E AVVIO
        try {
            if (window.supabase) {
                // Sostituisci questi valori con i tuoi reali se necessario
                supabaseClient = window.supabase.createClient(
                    'https://logqrcpotihtrmqjkkem.supabase.co', 
                    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxvZ3FyY3BvdGlodHJtcWpra2VtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk5OTI1NjEsImV4cCI6MjEwNTU2ODU2MX0.gP9AMgddEgMqrNLbGWaWktKzninII_WBd4Rzk-nodYA'
                );
            }
        } catch(e) { console.warn("Supabase non caricato correttamente", e); }

        function checkAndRepairData(data) {
            if (!data || typeof data !== 'object') data = JSON.parse(JSON.stringify(initialData));
            if (!Array.isArray(data.recipes)) data.recipes = [];
            if (!Array.isArray(data.portate)) data.portate = [...initialData.portate];
            if (!Array.isArray(data.allergeni)) data.allergeni = [...initialData.allergeni];
            if (!Array.isArray(data.tags)) data.tags = [...initialData.tags];
            if (!Array.isArray(data.ingredienti)) data.ingredienti = [...initialData.ingredienti];
            if (typeof data.unita_misura !== 'object') data.unita_misura = {};
            return data;
        }

        try {
            appData = checkAndRepairData(JSON.parse(localStorage.getItem('ricettarioApp_cloud')));
        } catch(e) {
            appData = JSON.parse(JSON.stringify(initialData));
        }

        window.onload = () => {
            // Avvio istantaneo dell'App protetto da errori
            try { if (typeof lucide !== 'undefined') lucide.createIcons(); } catch(e) { console.warn("Icone non caricate"); }
            populateMultiSelects();
            renderRecipesUI();
            syncConCloud();
        };

        async function syncConCloud() {
            if (!supabaseClient) return;
            try {
                const { data, error } = await supabaseClient.from('ricettario_cloud').select('data').eq('id', 1).single();
                if (!error && data && data.data && Object.keys(data.data).length > 0) {
                    appData = checkAndRepairData(data.data);
                    localStorage.setItem('ricettarioApp_cloud', JSON.stringify(appData));
                    
                    populateMultiSelects();
                    renderRecipesUI();
                    console.log("Cloud Sincronizzato con successo");
                } else {
                    await salvaSuCloudInBackgrond();
                }
            } catch (e) {
                console.warn("Nessuna connessione cloud disponibile, uso dati locali.", e);
            }
        }

        async function salvaSuCloudInBackgrond() {
            if (!supabaseClient) return;
            try { await supabaseClient.from('ricettario_cloud').upsert({ id: 1, data: appData }); } catch (e) {}
        }

        function saveData() {
            localStorage.setItem('ricettarioApp_cloud', JSON.stringify(appData));
            salvaSuCloudInBackgrond();
        }

        // --- SISTEMA COLORI E ORDINAMENTO ---
        const PORTATE_ORDER = ["Antipasto", "Primo Piatto", "Secondo Piatto", "Contorno", "Piatto Unico", "Panino", "Dessert"];
        function sortPortateArray(arr) {
            if(!Array.isArray(arr)) return [];
            return arr.sort((a, b) => {
                let iA = PORTATE_ORDER.indexOf(a), iB = PORTATE_ORDER.indexOf(b);
                if(iA===-1) iA=999; if(iB===-1) iB=999;
                return iA===iB ? (a||"").toString().localeCompare((b||"").toString()) : iA - iB;
            });
        }
        function sortAlphabetical(arr) {
            if(!Array.isArray(arr)) return [];
            return arr.sort((a,b) => (a||"").toString().localeCompare((b||"").toString(), 'it', {sensitivity:'base'}));
        }

        const colorPalettes = [
            { bg: 'var(--tag-1)', color: 'var(--text-tag-1)' }, { bg: 'var(--tag-2)', color: 'var(--text-tag-2)' },
            { bg: 'var(--tag-3)', color: 'var(--text-tag-3)' }, { bg: 'var(--tag-4)', color: 'var(--text-tag-4)' }, { bg: 'var(--tag-5)', color: 'var(--text-tag-5)' }
        ];
        function getTagStyle(text) {
            if (!text) return '';
            let hash = 0, str = text.toString();
            for (let i = 0; i < str.length; i++) hash = str.charCodeAt(i) + ((hash << 5) - hash);
            const style = colorPalettes[Math.abs(hash) % colorPalettes.length];
            return `background-color: ${style.bg}; color: ${style.color};`;
        }

        // --- UI & TOAST ---
        function safeCreateIcons() { try { if (typeof lucide !== 'undefined') lucide.createIcons(); } catch(e){} }

        function showToast(msg) {
            const c = document.getElementById('toast-container');
            if(!c) return;
            const t = document.createElement('div'); t.className = 'toast';
            t.innerHTML = `<i data-lucide="check-circle" style="color:#48bb78; width:18px;"></i> ${msg}`;
            c.appendChild(t); safeCreateIcons();
            setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 3000);
        }

        function setViewMode(mode) {
            viewMode = mode;
            document.getElementById('btnViewGrid').classList.toggle('active', mode === 'grid');
            document.getElementById('btnViewCompact').classList.toggle('active', mode === 'compact');
            renderRecipesUI();
        }

        // --- MULTI SELECT E FILTRI ---
        function toggleDropdown(id) {
            const el = document.getElementById(id);
            if(!el) return;
            const isAc = el.classList.contains('active');
            document.querySelectorAll('.multi-select-dropdown').forEach(d => d.classList.remove('active'));
            if(!isAc) el.classList.add('active');
        }
        
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.multi-select-container')) {
                document.querySelectorAll('.multi-select-dropdown').forEach(d => d.classList.remove('active'));
            }
        });

        function populateMultiSelects() {
            const buildList = (cId, dList, fKey) => {
                const c = document.getElementById(cId);
                if(!c || !Array.isArray(dList)) return;
                c.innerHTML = sortAlphabetical([...dList]).map(item => `
                    <label class="multi-select-item">
                        <input type="checkbox" onchange="toggleFilter('${fKey}', '${(item||'').toString().replace(/'/g, "\\'")}')" ${activeFilters[fKey].includes(item) ? 'checked' : ''}> ${item}
                    </label>
                `).join('');
            };
            buildList('dd-portata', appData.portate, 'portate');
            buildList('dd-allergeni', appData.allergeni, 'allergeni');
            buildList('dd-ingredienti', appData.ingredienti, 'ingredienti');
            updateActiveFiltersDisplay();
        }

        function toggleFilter(fKey, val) {
            const idx = activeFilters[fKey].indexOf(val);
            if(idx > -1) activeFilters[fKey].splice(idx, 1); else activeFilters[fKey].push(val);
            populateMultiSelects(); applyFilters();
        }

        function clearAllFilters() {
            activeFilters = { portate: [], allergeni: [], ingredienti: [] };
            const s = document.getElementById('searchInput'); if(s) s.value = '';
            populateMultiSelects(); applyFilters();
        }

        function updateActiveFiltersDisplay() {
            const bp = document.getElementById('badge-portata');
            if(bp) { bp.innerText = activeFilters.portate.length; bp.classList.toggle('hidden', activeFilters.portate.length === 0); }
            const ba = document.getElementById('badge-allergeni');
            if(ba) { ba.innerText = activeFilters.allergeni.length; ba.classList.toggle('hidden', activeFilters.allergeni.length === 0); }
            const bi = document.getElementById('badge-ingredienti');
            if(bi) { bi.innerText = activeFilters.ingredienti.length; bi.classList.toggle('hidden', activeFilters.ingredienti.length === 0); }

            let all = [];
            for (let k in activeFilters) activeFilters[k].forEach(val => all.push({key: k, val}));
            const d = document.getElementById('activeFiltersDisplay');
            if(d) {
                d.innerHTML = all.map(f => `<span class="active-filter-pill">${f.val} <i data-lucide="x" onclick="toggleFilter('${f.key}', '${f.val.replace(/'/g, "\\'")}')"></i></span>`).join('');
                safeCreateIcons();
            }
        }

        function applyFilters() { updateActiveFiltersDisplay(); renderRecipesUI(); }

        function getFilteredRecipes() {
            try {
                const searchInput = document.getElementById('searchInput');
                const search = searchInput ? searchInput.value.toLowerCase().trim() : "";
                const logicSelect = document.getElementById('filterLogicToggle');
                const logic = logicSelect ? logicSelect.value : 'AND'; 

                return (appData.recipes || []).filter(r => {
                    if (!r) return false;
                    const nome = (r.nome || "").toString().toLowerCase();
                    const prep = (r.preparazione || "").toString().toLowerCase();
                    
                    const txtMatch = search === "" || nome.includes(search) || prep.includes(search);
                    if (!txtMatch) return false;

                    const pActive = activeFilters.portate && activeFilters.portate.length > 0;
                    const aActive = activeFilters.allergeni && activeFilters.allergeni.length > 0;
                    const iActive = activeFilters.ingredienti && activeFilters.ingredienti.length > 0;

                    if (!pActive && !aActive && !iActive) return true;

                    const rAllerg = Array.isArray(r.allergeni) ? r.allergeni : [];
                    const rIngs = Array.isArray(r.ingredienti) ? r.ingredienti : [];
                    const rPortata = r.portata || "";

                    if (logic === 'AND') {
                        const pMatch = !pActive || activeFilters.portate.includes(rPortata);
                        const aMatch = !aActive || activeFilters.allergeni.every(x => rAllerg.includes(x));
                        const iMatch = !iActive || activeFilters.ingredienti.every(x => rIngs.some(ri => ri && (ri.nome === x || ri === x)));
                        return pMatch && aMatch && iMatch;
                    } else {
                        const pMatch = pActive && activeFilters.portate.includes(rPortata);
                        const aMatch = aActive && activeFilters.allergeni.some(x => rAllerg.includes(x));
                        const iMatch = iActive && activeFilters.ingredienti.some(x => rIngs.some(ri => ri && (ri.nome === x || ri === x)));
                        return pMatch || aMatch || iMatch;
                    }
                });
            } catch(e) { console.error("Errore filtri", e); return []; }
        }

        function renderRecipesUI() {
            const gSelect = document.getElementById('groupingSelect');
            groupBy = gSelect ? gSelect.value : 'none';
            let list = getFilteredRecipes();
            const container = document.getElementById('recipeRenderContainer');
            if(!container) return;
            container.innerHTML = '';

            if (list.length === 0) {
                container.innerHTML = '<div class="no-results">Nessuna ricetta trovata.</div>';
                return;
            }

            if (groupBy === 'portata') {
                sortPortateArray([...(appData.portate || [])]).forEach(port => {
                    const groupItems = list.filter(r => r.portata === port);
                    if (groupItems.length > 0) {
                        container.innerHTML += `<div class="group-header-title">${port}</div>` + generateHTMLForList(groupItems);
                    }
                });
                const noPortata = list.filter(r => !r.portata);
                if (noPortata.length > 0) {
                    container.innerHTML += `<div class="group-header-title">Altro</div>` + generateHTMLForList(noPortata);
                }
            } else {
                container.innerHTML = generateHTMLForList(list);
            }
            safeCreateIcons();
        }

        function generateHTMLForList(recipes) {
            if (!Array.isArray(recipes)) return "";
            if (viewMode === 'compact') {
                return `<div class="recipe-list-compact">` + recipes.map(r => {
                    const safeAllergeni = Array.isArray(r.allergeni) ? r.allergeni : [];
                    const safeTags = Array.isArray(r.tags) ? r.tags : [];
                    const tagsHtml = [...safeAllergeni, ...safeTags].filter(Boolean).slice(0,3).map(t => `<span class="tag-pill" style="${getTagStyle(t)}">${t}</span>`).join('');
                    return `
                    <div class="compact-item" onclick="showDetailView(${r.id})">
                        <span class="portata-badge compact-badge" style="margin:0;">${r.portata || '-'}</span>
                        <div class="compact-title">${r.nome || 'Senza Nome'}</div>
                        <div class="compact-tags">${tagsHtml}</div>
                        <div class="compact-actions"><button class="icon-btn danger" onclick="event.stopPropagation(); deleteRecipe(${r.id})"><i data-lucide="trash-2"></i></button></div>
                    </div>`;
                }).join('') + `</div>`;
            } else {
                return `<div class="recipe-grid">` + recipes.map(r => {
                    const safeAllergeni = Array.isArray(r.allergeni) ? r.allergeni : [];
                    const safeTags = Array.isArray(r.tags) ? r.tags : [];
                    const allTags = [...safeAllergeni, ...safeTags].filter(Boolean);
                    const tagsHtml = allTags.slice(0, 3).map(t => `<span class="tag-pill" style="${getTagStyle(t)}">${t}</span>`).join('') + (allTags.length > 3 ? '<span class="tag-pill" style="background:#eee;color:#666;">+</span>' : '');
                    const ingPreview = Array.isArray(r.ingredienti) && r.ingredienti.length > 0 ? r.ingredienti.map(i => i.nome || i).join(', ') : 'Nessun ingrediente...';
                    const hasImg = r.immagine && r.immagine.trim() !== "";
                    const bgStyle = hasImg ? `style="background-image: url('${r.immagine}');"` : "";

                    return `
                    <div class="recipe-card ${hasImg ? 'has-image' : ''}" ${bgStyle} onclick="showDetailView(${r.id})">
                        <div class="card-actions-top"><button class="icon-btn danger" onclick="event.stopPropagation(); deleteRecipe(${r.id})" title="Elimina"><i data-lucide="trash-2" style="width:14px;"></i></button></div>
                        <span class="portata-badge">${r.portata || ''}</span>
                        <h3 class="recipe-title serif-font">${r.nome || 'Senza Nome'}</h3>
                        <div class="tags-area">${tagsHtml}</div>
                        <div class="ingredients-preview"><strong>Ingredienti:</strong> ${ingPreview}</div>
                    </div>`;
                }).join('') + `</div>`;
            }
        }

        // --- GESTIONE SCHERMATE E MODALI ---
        function showDetailView(id) {
            try {
                currentRecipeId = id;
                document.getElementById('main-view').classList.add('hidden');
                document.getElementById('detail-view').classList.remove('hidden');
                
                const recipe = appData.recipes.find(r => r.id === id);
                if(!recipe) return showMainView();

                document.getElementById('d-title').innerText = recipe.nome || 'Senza Nome';
                document.getElementById('d-origin').innerHTML = recipe.origine ? `<i data-lucide="map-pin" style="width:14px;"></i> ${recipe.origine}` : '';
                
                const imgEl = document.getElementById('d-image');
                if(recipe.immagine) { imgEl.src = recipe.immagine; imgEl.classList.remove('hidden'); } else { imgEl.classList.add('hidden'); }
                
                const allTags = [...(Array.isArray(recipe.allergeni)?recipe.allergeni:[]), ...(Array.isArray(recipe.tags)?recipe.tags:[])].filter(Boolean);
                document.getElementById('d-tags').innerHTML = allTags.map(t => `<span class="tag-pill" style="${getTagStyle(t)}">${t}</span>`).join('');
                
                basePortions = recipe.porzioni || 2;
                document.getElementById('portionInput').value = basePortions;
                originalIngredients = JSON.parse(JSON.stringify(recipe.ingredienti || []));
                document.getElementById('d-prep').innerText = recipe.preparazione || "Procedimento non specificato.";
                
                recalculatePortions(); safeCreateIcons(); window.scrollTo(0,0);
            } catch(e) { console.error(e); }
        }

        function showMainView() {
            document.getElementById('detail-view').classList.add('hidden');
            document.getElementById('main-view').classList.remove('hidden');
            currentRecipeId = null; renderRecipesUI();
        }

        function recalculatePortions() {
            const currentPortions = parseFloat(document.getElementById('portionInput').value) || basePortions;
            const ratio = currentPortions / basePortions;
            const ul = document.getElementById('d-ingredients'); ul.innerHTML = '';
            
            if(!Array.isArray(originalIngredients) || originalIngredients.length === 0) {
                ul.innerHTML = '<li><span style="color:#999;">Nessun ingrediente inserito. Usa la matita.</span></li>'; return;
            }
            originalIngredients.forEach(ing => {
                let nome = ing.nome || ing; let displayQty = "";
                if(ing.qta) {
                    let newQta = ing.qta * ratio;
                    displayQty = Number.isInteger(newQta) ? newQta : newQta.toFixed(1);
                }
                ul.innerHTML += `<li><span>${nome}</span> <span class="ing-qty">${displayQty} ${ing.unita || ''}</span></li>`;
            });
        }

        function editCurrentRecipe() { if(currentRecipeId) openRecipeModal(currentRecipeId); }
        function markDirty() { isFormDirty = true; }
        function closeModal(id) { const el = document.getElementById(id); if(el) el.classList.remove('active'); }

        function autoFillUnit() {
            const nome = document.getElementById('formIngNome').value.trim();
            if(!nome) return;
            const capitalName = nome.charAt(0).toUpperCase() + nome.slice(1).toLowerCase();
            const unitInput = document.getElementById('formIngUnit');
            if (appData.unita_misura && appData.unita_misura[capitalName] !== undefined) unitInput.value = appData.unita_misura[capitalName];
        }

        function openRecipeModal(id = null) {
            isFormDirty = false;
            document.getElementById('recipeModal').classList.add('active');
            document.getElementById('modalRecipeTitle').innerText = id ? 'Modifica Ricetta' : 'Nuova Ricetta';
            document.querySelectorAll('#recipeModal input, #recipeModal textarea, #recipeModal select').forEach(el => el.addEventListener('input', markDirty, {once:true}));
            
            document.getElementById('formPortata').innerHTML = '<option value="">-- Nessuna --</option>' + sortPortateArray([...(appData.portate||[])]).map(p => `<option value="${p}">${p}</option>`).join('');
            document.getElementById('ingDatalist').innerHTML = sortAlphabetical([...(appData.ingredienti||[])]).map(i => `<option value="${i}">`).join('');
            
            const buildTokens = (cId, list, gName) => {
                document.getElementById(cId).innerHTML = sortAlphabetical([...(list||[])]).map((item, i) => `
                    <div><input type="checkbox" id="${gName}_${i}" value="${item}" class="token-checkbox" name="${gName}" onchange="markDirty()"><label for="${gName}_${i}" class="token-label">${item}</label></div>
                `).join('');
            };
            buildTokens('formAllergeni', appData.allergeni, 'chk_all');
            buildTokens('formTags', appData.tags, 'chk_tag');

            tempIngredients = [];

            if (id) {
                const r = appData.recipes.find(x => x.id === id);
                if(r) {
                    document.getElementById('formRecipeId').value = r.id;
                    document.getElementById('formNome').value = r.nome || '';
                    document.getElementById('formImmagine').value = r.immagine || '';
                    document.getElementById('formPortata').value = r.portata || '';
                    document.getElementById('formPorzioni').value = r.porzioni || 2;
                    document.getElementById('formPrep').value = r.preparazione || '';
                    document.getElementById('formOrigine').value = r.origine || '';
                    tempIngredients = JSON.parse(JSON.stringify(r.ingredienti || []));
                    
                    document.getElementsByName('chk_all').forEach(cb => { if((r.allergeni||[]).includes(cb.value)) cb.checked = true; });
                    document.getElementsByName('chk_tag').forEach(cb => { if((r.tags||[]).includes(cb.value)) cb.checked = true; });
                }
            } else {
                document.getElementById('formRecipeId').value = ''; document.getElementById('formNome').value = '';
                document.getElementById('formImmagine').value = ''; document.getElementById('formPortata').value = '';
                document.getElementById('formPorzioni').value = 2; document.getElementById('formPrep').value = '';
                document.getElementById('formOrigine').value = '';
            }
            renderFormIngredients();
        }

        function attemptCloseRecipeModal() {
            if(isFormDirty) { if(confirm("Vuoi chiudere lo stesso e perdere le modifiche?")) closeModal('recipeModal'); } 
            else closeModal('recipeModal');
        }

        function addIngredientToForm() {
            const nomeInput = document.getElementById('formIngNome');
            let nome = nomeInput.value.trim();
            if(!nome) return;
            nome = nome.charAt(0).toUpperCase() + nome.slice(1).toLowerCase();

            const qta = parseFloat(document.getElementById('formIngQta').value) || null;
            const unita = document.getElementById('formIngUnit').value.trim();
            
            if(!appData.ingredienti.some(i => (i||'').toLowerCase() === nome.toLowerCase())) {
                appData.ingredienti.push(nome);
                if(!appData.unita_misura) appData.unita_misura = {};
                appData.unita_misura[nome] = unita;
                saveData(); populateMultiSelects(); 
                document.getElementById('ingDatalist').innerHTML = appData.ingredienti.map(i => `<option value="${i}">`).join('');
            }
            tempIngredients.push({ nome, qta, unita });
            nomeInput.value = ''; document.getElementById('formIngQta').value = ''; document.getElementById('formIngUnit').value = '';
            markDirty(); renderFormIngredients(); nomeInput.focus();
        }

        function removeIngredientFromForm(idx) { tempIngredients.splice(idx, 1); markDirty(); renderFormIngredients(); }

        function renderFormIngredients() {
            const container = document.getElementById('formAddedIngredients');
            if(tempIngredients.length === 0) { container.innerHTML = '<span style="color:#999;font-size:0.9rem;">Nessun ingrediente inserito.</span>'; return; }
            container.innerHTML = tempIngredients.map((ing, i) => `
                <div class="ing-list-item">
                    <span><strong>${ing.nome || ing}</strong> ${ing.qta ? ': ' + ing.qta : ''} ${ing.unita || ''}</span>
                    <button class="icon-btn danger" style="width:24px;height:24px;" onclick="removeIngredientFromForm(${i})"><i data-lucide="x" style="width:14px;"></i></button>
                </div>
            `).join('');
            safeCreateIcons();
        }

        function saveRecipe() {
            const id = document.getElementById('formRecipeId').value;
            const nome = document.getElementById('formNome').value.trim();
            if (!nome) return alert("Il nome della ricetta è obbligatorio.");

            const rData = {
                id: id ? parseInt(id) : (appData.recipes.length > 0 ? Math.max(...appData.recipes.map(x=>x.id))+1 : 1),
                nome: nome,
                immagine: document.getElementById('formImmagine').value.trim(),
                portata: document.getElementById('formPortata').value,
                porzioni: parseInt(document.getElementById('formPorzioni').value) || 2,
                ingredienti: tempIngredients,
                preparazione: document.getElementById('formPrep').value,
                allergeni: Array.from(document.querySelectorAll(`input[name="chk_all"]:checked`)).map(cb => cb.value),
                tags: Array.from(document.querySelectorAll(`input[name="chk_tag"]:checked`)).map(cb => cb.value),
                origine: document.getElementById('formOrigine').value
            };

            if (id) {
                const idx = appData.recipes.findIndex(x => x.id == id);
                if(idx > -1) appData.recipes[idx] = rData;
                if(currentRecipeId == id) showDetailView(id); 
            } else appData.recipes.unshift(rData);

            saveData(); isFormDirty = false; closeModal('recipeModal'); showToast("Ricetta salvata!");
            if(!currentRecipeId) renderRecipesUI();
        }

        function openImportModal() { document.getElementById('importCodeInput').value = ''; document.getElementById('importModal').classList.add('active'); }

        function importRecipeCode() {
            try {
                const codeString = document.getElementById('importCodeInput').value;
                if (!codeString.trim()) throw new Error("Campo vuoto.");
                const parsedData = JSON.parse(codeString);
                const recipesToImport = Array.isArray(parsedData) ? parsedData : [parsedData];
                if (recipesToImport.length === 0) throw new Error("Nessuna ricetta trovata.");

                recipesToImport.forEach(newRecipe => {
                    if (!newRecipe.nome) throw new Error("Manca il 'nome'.");
                    newRecipe.id = appData.recipes.length > 0 ? Math.max(...appData.recipes.map(x=>x.id))+1 : 1;
                    const addIfMissing = (arr, val) => { if (val && !arr.includes(val)) arr.push(val); };
                    
                    addIfMissing(appData.portate, newRecipe.portata);
                    (newRecipe.tags || []).forEach(t => addIfMissing(appData.tags, t));
                    (newRecipe.allergeni || []).forEach(a => addIfMissing(appData.allergeni, a));
                    (newRecipe.ingredienti || []).forEach(ing => {
                        let n = typeof ing === 'string' ? ing : ing.nome;
                        if (n) {
                            n = n.charAt(0).toUpperCase() + n.slice(1).toLowerCase();
                            if(typeof ing === 'object') ing.nome = n;
                            if(!appData.ingredienti.some(i => (i||'').toLowerCase() === n.toLowerCase())) {
                                appData.ingredienti.push(n);
                                if(!appData.unita_misura) appData.unita_misura = {};
                                if(typeof ing === 'object' && ing.unita) appData.unita_misura[n] = ing.unita;
                            }
                        }
                    });
                    appData.recipes.unshift(newRecipe);
                });
                saveData(); closeModal('importModal'); populateMultiSelects(); renderRecipesUI(); 
                showToast(recipesToImport.length > 1 ? `${recipesToImport.length} ricette importate!` : "Ricetta importata!");
            } catch (e) { alert("Errore JSON: " + e.message); }
        }

        function deleteRecipe(id) { 
            appData.recipes = appData.recipes.filter(r => r.id !== id); 
            saveData(); renderRecipesUI(); showToast("Ricetta eliminata."); 
        }

        // --- GESTORE LIBRERIE GLOBALI ---
        function openManagerModal() { document.getElementById('managerModal').classList.add('active'); renderManagerList(); }

        function renderManagerList() {
            const type = document.getElementById('managerType').value;
            let list = appData[type];
            if(type === 'portate') list = sortPortateArray([...list]); else list = sortAlphabetical([...list]);

            if (type === 'ingredienti') {
                document.getElementById('metaItemsContainer').innerHTML = list.map((item) => {
                    const realIdx = appData[type].indexOf(item);
                    const defU = (appData.unita_misura && appData.unita_misura[item]) ? appData.unita_misura[item] : '';
                    return `
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:8px; border-bottom:1px solid #eee; gap: 10px;">
                        <span style="flex:1;">${item}</span>
                        <input type="text" class="form-control" style="width:100px; padding: 4px 8px;" placeholder="Unità" value="${defU}" onchange="updateDefaultUnit('${(item||'').replace(/'/g, "\\'")}', this.value)">
                        <button class="icon-btn danger" style="width:24px;height:24px;border:none;" onclick="deleteMetaItem('${type}', ${realIdx})"><i data-lucide="trash-2" style="width:14px;"></i></button>
                    </div>`;
                }).join('');
            } else {
                document.getElementById('metaItemsContainer').innerHTML = list.map((item) => {
                    const realIdx = appData[type].indexOf(item);
                    return `
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:8px; border-bottom:1px solid #eee;">
                        <span>${item}</span><button class="icon-btn danger" style="width:24px;height:24px;border:none;" onclick="deleteMetaItem('${type}', ${realIdx})"><i data-lucide="trash-2" style="width:14px;"></i></button>
                    </div>`;
                }).join('');
            }
            safeCreateIcons();
        }

        function updateDefaultUnit(ingName, newUnit) { if (!appData.unita_misura) appData.unita_misura = {}; appData.unita_misura[ingName] = newUnit; saveData(); showToast("Unità aggiornata."); }
        function addMetaItem() {
            const type = document.getElementById('managerType').value;
            let val = document.getElementById('newMetaInput').value.trim();
            if(type !== 'portate' && val) val = val.charAt(0).toUpperCase() + val.slice(1).toLowerCase();
            if(val && !appData[type].some(i=>(i||'').toLowerCase()===(val||'').toLowerCase())) { appData[type].push(val); saveData(); document.getElementById('newMetaInput').value = ''; renderManagerList(); showToast("Aggiunto."); }
        }
        function deleteMetaItem(type, idx) { appData[type].splice(idx, 1); saveData(); renderManagerList(); }
        function closeManagerAndRefresh() { closeModal('managerModal'); populateMultiSelects(); renderRecipesUI(); }

        // --- BACKUP E ESPORTAZIONE ---
        function exportDatabase() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData));
            const node = document.createElement('a');
            node.setAttribute("href", dataStr); node.setAttribute("download", "ricettario_backup.json");
            document.body.appendChild(node); node.click(); node.remove(); showToast("Backup esportato.");
        }

        function importDatabase(event) {
            const file = event.target.files[0]; if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (imported.recipes) {
                        appData = checkAndRepairData(imported);
                        saveData(); populateMultiSelects(); renderRecipesUI(); showToast("Backup importato!");
                    } else alert("File non valido.");
                } catch (err) { alert("Errore di lettura."); }
            };
            reader.readAsText(file); event.target.value = ''; 
        }

        function exportCurrentPDF() {
            if(!currentRecipeId) return;
            const recipe = appData.recipes.find(r => r.id === currentRecipeId);
            if(!recipe) return;
            const container = document.getElementById('pdf-export-container');
            const p = parseFloat(document.getElementById('portionInput').value) || recipe.porzioni;
            const ings = Array.from(document.getElementById('d-ingredients').children).map(li => li.innerText).map(t => `<li>${t}</li>`).join('');

            container.innerHTML = `
                <div style="text-align:center; border-bottom: 2px solid #d97757; padding-bottom:20px; margin-bottom:30px;">
                    <div style="color:#718096; font-size:14px; text-transform:uppercase;">${recipe.portata || ''}</div>
                    <h1 style="font-family:'Playfair Display', serif; font-size:36px; color:#2d3748; margin:10px 0;">${recipe.nome || 'Senza Nome'}</h1>
                    ${recipe.origine ? `<div style="font-size:14px; color:#718096;">${recipe.origine}</div>` : ''}
                </div>
                <div style="display:flex; gap:30px;">
                    <div style="flex:1;">
                        <h3 style="color:#d97757; border-bottom:1px solid #eee; margin-bottom:15px; padding-bottom:5px;">Ingredienti (per ${p} porzioni)</h3>
                        <ul style="list-style:none; padding:0; line-height:2;">${ings || 'Nessun ingrediente.'}</ul>
                        <h3 style="color:#d97757; border-bottom:1px solid #eee; margin-top:30px; margin-bottom:15px; padding-bottom:5px;">Info</h3>
                        <p style="font-size:12px; color:#555;"><strong>Allergeni:</strong> ${(recipe.allergeni||[]).join(', ')}</p>
                        <p style="font-size:12px; color:#555;"><strong>Tag:</strong> ${(recipe.tags||[]).join(', ')}</p>
                    </div>
                    <div style="flex:2;"><h3 style="color:#d97757; border-bottom:1px solid #eee; margin-bottom:15px; padding-bottom:5px;">Preparazione</h3><div style="line-height:1.8; white-space:pre-wrap; color:#333;">${recipe.preparazione || ''}</div></div>
                </div>`;
            container.style.display = 'block';
            html2pdf().set({ margin: 15, filename: `Ricetta_${(recipe.nome||'Pdf').replace(/\s+/g, '_')}.pdf`, image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' } }).from(container).save().then(() => container.style.display = 'none');
        }
    </script>
</body>
</html>
